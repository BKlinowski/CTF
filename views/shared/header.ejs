<header class="header">
  <a class="header-title" href="/">CODEBERRY</a>

  <div class="hamburger-menu">
    <input id="menu__toggle" type="checkbox" />
    <label class="menu__btn" for="menu__toggle">
      <span></span>
    </label>

    <ul class="menu__box">
      <li><a class="menu__item" href="/services">Usugi</a></li>
      <li><a class="menu__item" href="/mobiles">Rozwiązania Mobilne</a></li>
      <li><a class="menu__item" href="/e-commerce">E-commerce</a></li>
      <li><a class="menu__item" href="/websites">Portale internetowe</a></li>
      <li>
        <a class="menu__item" href="/feedback">Podziel się swoja opinia</a>
      </li>
      <li><a class="menu__item" href="/career">Kariera</a></li>
      <li><a class="menu__item" href="/about-us">O nas</a></li>
      <li><a class="menu__item" href="/contact">Kontakt</a></li>
      <li><a class="menu__item" href="/admin">Admin</a></li>
      <% if(role === "admin") { %>
      <li>
        <a class="menu__item" href="/users">Informacje o użytkownikach</a>
      </li>
      <% } %>
    </ul>
  </div>

  <div class="header-right">
